@startuml
set separator none
title API RutaSIT - Dynamic

left to right direction

skinparam {
  arrowFontSize 10
  defaultTextAlignment center
  wrapWidth 200
  maxMessageSize 100
}

hide stereotype

skinparam rectangle<<RutaSIT.Aplicaciónwebprogresiva>> {
  BackgroundColor #438dd5
  FontColor #ffffff
  BorderColor #2e6295
  shadowing false
}
skinparam database<<RutaSIT.Caché>> {
  BackgroundColor #438dd5
  FontColor #ffffff
  BorderColor #2e6295
  shadowing false
}
skinparam rectangle<<RutaSIT.APIRutaSIT.MóduloAlertas>> {
  BackgroundColor #85bbf0
  FontColor #000000
  BorderColor #5d82a8
  shadowing false
}
skinparam rectangle<<RutaSIT.APIRutaSIT.MóduloETA>> {
  BackgroundColor #85bbf0
  FontColor #000000
  BorderColor #5d82a8
  shadowing false
}
skinparam rectangle<<RutaSIT.APIRutaSIT.MóduloSeguimiento>> {
  BackgroundColor #85bbf0
  FontColor #000000
  BorderColor #5d82a8
  shadowing false
}
skinparam rectangle<<Proveedordemapas>> {
  BackgroundColor #999999
  FontColor #ffffff
  BorderColor #6b6b6b
  shadowing false
}
skinparam rectangle<<RutaSIT.APIRutaSIT>> {
  BorderColor #2e6295
  FontColor #2e6295
  shadowing false
}

rectangle "API RutaSIT\n<size:10>[Container: Python / Django]</size>" <<RutaSIT.APIRutaSIT>> {
  rectangle "==Módulo ETA\n<size:10>[Component: Django app]</size>\n\nCalcula el tiempo de llegada a cada paradero." <<RutaSIT.APIRutaSIT.MóduloETA>> as RutaSIT.APIRutaSIT.MóduloETA
  rectangle "==Módulo Alertas\n<size:10>[Component: Django app]</size>\n\nAvisa al operador de desvíos y de buses sin señal." <<RutaSIT.APIRutaSIT.MóduloAlertas>> as RutaSIT.APIRutaSIT.MóduloAlertas
  rectangle "==Módulo Seguimiento\n<size:10>[Component: Django app]</size>\n\nGuarda los viajes y sus posiciones y controla su estado." <<RutaSIT.APIRutaSIT.MóduloSeguimiento>> as RutaSIT.APIRutaSIT.MóduloSeguimiento
}

database "==Caché\n<size:10>[Container: Redis]</size>\n\nÚltima posición de cada bus y tiempos de llegada ya calculados." <<RutaSIT.Caché>> as RutaSIT.Caché
rectangle "==Proveedor de mapas\n<size:10>[Software System]</size>\n\nEntrega los mapas y calcula el tiempo de recorrido entre dos puntos." <<Proveedordemapas>> as Proveedordemapas
rectangle "==Aplicación web progresiva\n<size:10>[Container: JavaScript + Service Worker]</size>\n\nMapa y consulta de llegadas para el pasajero; panel de alertas para el operador." <<RutaSIT.Aplicaciónwebprogresiva>> as RutaSIT.Aplicaciónwebprogresiva

RutaSIT.Aplicaciónwebprogresiva .[#707070,thickness=2].> RutaSIT.APIRutaSIT.MóduloETA : "<color:#707070>1. Consulta el tiempo de llegada\n<color:#707070><size:8>[HTTPS/JSON]</size>"
RutaSIT.APIRutaSIT.MóduloETA .[#707070,thickness=2].> RutaSIT.APIRutaSIT.MóduloSeguimiento : "<color:#707070>2. Busca los viajes activos y su última posición\n<color:#707070><size:8>[Python (llamada interna)]</size>"
RutaSIT.APIRutaSIT.MóduloETA .[#707070,thickness=2].> Proveedordemapas : "<color:#707070>3. Pide el tiempo de recorrido\n<color:#707070><size:8>[HTTPS/JSON]</size>"
RutaSIT.APIRutaSIT.MóduloETA .[#707070,thickness=2].> RutaSIT.APIRutaSIT.MóduloAlertas : "<color:#707070>4. Avisa si los buses no tienen señal\n<color:#707070><size:8>[Python (llamada interna)]</size>"
RutaSIT.APIRutaSIT.MóduloETA .[#707070,thickness=2].> RutaSIT.Caché : "<color:#707070>5. Guarda el tiempo calculado\n<color:#707070><size:8>[Redis protocol]</size>"
@enduml