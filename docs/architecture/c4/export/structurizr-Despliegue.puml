rectangle "Celular o PC del usuario\n<size:10>[Deployment Node: Android / navegador web]</size>" <<Producción.CelularoPCdelusuario>> as Producción.CelularoPCdelusuario {
  rectangle "==Aplicación web progresiva\n<size:10>[Container: JavaScript + Service Worker]</size>\n\nMapa y consulta de llegadas para el pasajero; panel de alertas para el operador." <<Producción.CelularoPCdelusuario.Aplicaciónwebprogresiva_1>> as Producción.CelularoPCdelusuario.Aplicaciónwebprogresiva_1
}

rectangle "VPS en la nube\n<size:10>[Deployment Node: Ubuntu 24.04, 2 vCPU, 4 GB RAM]</size>" <<Producción.VPSenlanube>> as Producción.VPSenlanube {
  rectangle "==Nginx\n<size:10>[Infrastructure Node: Nginx (limit_req)]</size>\n\nRecibe las peticiones, aplica HTTPS y limita la tasa de solicitudes por dispositivo. [QA-06]" <<Producción.VPSenlanube.Nginx>> as Producción.VPSenlanube.Nginx
  rectangle "==Respaldo diario\n<size:10>[Infrastructure Node: cron + pg_dump]</size>\n\nCopia diaria de la base de datos para recuperar el servicio en 2 horas. [riesgo R1]" <<Producción.VPSenlanube.Respaldodiario>> as Producción.VPSenlanube.Respaldodiario
  rectangle "==Grafana\n<size:10>[Infrastructure Node: Grafana]</size>\n\nMuestra el estado del servidor y de la aplicación." <<Producción.VPSenlanube.Grafana>> as Producción.VPSenlanube.Grafana
  rectangle "Servidor de aplicación\n<size:10>[Deployment Node: Django]</size>" <<Producción.VPSenlanube.Servidordeaplicación>> as Producción.VPSenlanube.Servidordeaplicación {
    rectangle "==API RutaSIT\n<size:10>[Container: Python / Django]</size>\n\nMonolito modular que recibe posiciones, calcula tiempos de llegada y genera alertas. [QA-01, QA-02, QA-03, QA-05, QA-06]" <<Producción.VPSenlanube.Servidordeaplicación.APIRutaSIT_1>> as Producción.VPSenlanube.Servidordeaplicación.APIRutaSIT_1
  }

  rectangle "Servidor de base de datos\n<size:10>[Deployment Node: PostgreSQL + PostGIS]</size>" <<Producción.VPSenlanube.Servidordebasededatos>> as Producción.VPSenlanube.Servidordebasededatos {
    database "==Base de datos\n<size:10>[Container: PostgreSQL + PostGIS (índice GiST)]</size>\n\nRutas, paraderos, viajes, posiciones y alertas (un esquema por módulo). Índice espacial y filtro obligatorio por operador. [QA-01, QA-05]" <<Producción.VPSenlanube.Servidordebasededatos.Basededatos_1>> as Producción.VPSenlanube.Servidordebasededatos.Basededatos_1
  }

  rectangle "Servidor de caché\n<size:10>[Deployment Node: Redis]</size>" <<Producción.VPSenlanube.Servidordecaché>> as Producción.VPSenlanube.Servidordecaché {
    database "==Caché\n<size:10>[Container: Redis]</size>\n\nÚltima posición de cada bus y ETA por paradero con TTL de 10 s; si se vacía, se reconstruye desde PostgreSQL. [QA-01, QA-04]" <<Producción.VPSenlanube.Servidordecaché.Caché_1>> as Producción.VPSenlanube.Servidordecaché.Caché_1
  }

}

