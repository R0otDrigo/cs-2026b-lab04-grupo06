@startuml
set separator none
title RutaSIT - System Context

left to right direction

skinparam {
  arrowFontSize 10
  defaultTextAlignment center
  wrapWidth 200
  maxMessageSize 100
}

hide stereotype

skinparam rectangle<<DispositivosGPSdelosbuses>> {
  BackgroundColor #999999
  FontColor #ffffff
  BorderColor #6b6b6b
  shadowing false
}
skinparam person<<Operador>> {
  BackgroundColor #08427b
  FontColor #ffffff
  BorderColor #052e56
  shadowing false
}
skinparam person<<Pasajero>> {
  BackgroundColor #08427b
  FontColor #ffffff
  BorderColor #052e56
  shadowing false
}
skinparam rectangle<<Proveedordemapas>> {
  BackgroundColor #999999
  FontColor #ffffff
  BorderColor #6b6b6b
  shadowing false
}
skinparam rectangle<<RutaSIT>> {
  BackgroundColor #1168bd
  FontColor #ffffff
  BorderColor #0b4884
  shadowing false
}

person "==Pasajero\n<size:10>[Person]</size>\n\nPersona que consulta dónde está su bus y cuánto demora en llegar." <<Pasajero>> as Pasajero
person "==Operador\n<size:10>[Person]</size>\n\nPersonal del SIT que supervisa los buses y atiende las alertas." <<Operador>> as Operador
rectangle "==Dispositivos GPS de los buses\n<size:10>[Software System]</size>\n\nEnvían la posición de cada bus cada 10 segundos." <<DispositivosGPSdelosbuses>> as DispositivosGPSdelosbuses
rectangle "==Proveedor de mapas\n<size:10>[Software System]</size>\n\nEntrega los mapas y calcula el tiempo de recorrido entre dos puntos." <<Proveedordemapas>> as Proveedordemapas
rectangle "==RutaSIT\n<size:10>[Software System]</size>\n\nMuestra la ubicación de los buses y el tiempo de llegada a cada paradero." <<RutaSIT>> as RutaSIT

Pasajero .[#707070,thickness=2].> RutaSIT : "<color:#707070>Consulta dónde está su bus y cuánto demora en llegar"
Operador .[#707070,thickness=2].> RutaSIT : "<color:#707070>Supervisa los buses y atiende las alertas"
DispositivosGPSdelosbuses .[#707070,thickness=2].> RutaSIT : "<color:#707070>Envía la posición del bus\n<color:#707070><size:8>[HTTPS/JSON]</size>"
RutaSIT .[#707070,thickness=2].> Proveedordemapas : "<color:#707070>Pide mapas y tiempos de recorrido\n<color:#707070><size:8>[HTTPS]</size>"
@enduml