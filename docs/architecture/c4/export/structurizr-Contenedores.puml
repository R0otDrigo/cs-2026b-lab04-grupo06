@startuml
set separator none
title RutaSIT - Containers

left to right direction

skinparam {
  arrowFontSize 10
  defaultTextAlignment center
  wrapWidth 200
  maxMessageSize 100
}

hide stereotype

skinparam rectangle<<RutaSIT.APIRutaSIT>> {
  BackgroundColor #438dd5
  FontColor #ffffff
  BorderColor #2e6295
  shadowing false
}
skinparam rectangle<<RutaSIT.Aplicaciónwebprogresiva>> {
  BackgroundColor #438dd5
  FontColor #ffffff
  BorderColor #2e6295
  shadowing false
}
skinparam database<<RutaSIT.Basededatos>> {
  BackgroundColor #438dd5
  FontColor #ffffff
  BorderColor #2e6295
  shadowing false
}
skinparam database<<RutaSIT.Caché>> {
  BackgroundColor #438dd5
  FontColor #ffffff
  BorderColor #2e6295
  shadowing false
}
skinparam rectangle<<DispositivosGPSdelosbuses>> {
  BackgroundColor #999999
  FontColor #ffffff
  BorderColor #6b6b6b
  shadowing false
}
skinparam person<<Operador>> {
  BackgroundColor #08427b
  FontColor #ffffff
  BorderColor #052e56
  shadowing false
}
skinparam person<<Pasajero>> {
  BackgroundColor #08427b
  FontColor #ffffff
  BorderColor #052e56
  shadowing false
}
skinparam rectangle<<Proveedordemapas>> {
  BackgroundColor #999999
  FontColor #ffffff
  BorderColor #6b6b6b
  shadowing false
}
skinparam rectangle<<RutaSIT>> {
  BorderColor #0b4884
  FontColor #0b4884
  shadowing false
}

person "==Pasajero\n<size:10>[Person]</size>\n\nPersona que consulta dónde está su bus y cuánto demora en llegar." <<Pasajero>> as Pasajero
person "==Operador\n<size:10>[Person]</size>\n\nPersonal del SIT que supervisa los buses y atiende las alertas." <<Operador>> as Operador
rectangle "==Dispositivos GPS de los buses\n<size:10>[Software System]</size>\n\nEnvían la posición de cada bus cada 10 segundos." <<DispositivosGPSdelosbuses>> as DispositivosGPSdelosbuses
rectangle "==Proveedor de mapas\n<size:10>[Software System]</size>\n\nEntrega los mapas y calcula el tiempo de recorrido entre dos puntos." <<Proveedordemapas>> as Proveedordemapas

rectangle "RutaSIT\n<size:10>[Software System]</size>" <<RutaSIT>> {
  database "==Base de datos\n<size:10>[Container: PostgreSQL + PostGIS]</size>\n\nRutas, paraderos, viajes, posiciones y alertas (un esquema por módulo)." <<RutaSIT.Basededatos>> as RutaSIT.Basededatos
  database "==Caché\n<size:10>[Container: Redis]</size>\n\nÚltima posición de cada bus y tiempos de llegada ya calculados." <<RutaSIT.Caché>> as RutaSIT.Caché
  rectangle "==Aplicación web progresiva\n<size:10>[Container: JavaScript + Service Worker]</size>\n\nMapa y consulta de llegadas para el pasajero; panel de alertas para el operador." <<RutaSIT.Aplicaciónwebprogresiva>> as RutaSIT.Aplicaciónwebprogresiva
  rectangle "==API RutaSIT\n<size:10>[Container: Python / Django]</size>\n\nMonolito modular que recibe posiciones, calcula tiempos de llegada y genera alertas." <<RutaSIT.APIRutaSIT>> as RutaSIT.APIRutaSIT
}

Pasajero .[#707070,thickness=2].> RutaSIT.Aplicaciónwebprogresiva : "<color:#707070>Usa\n<color:#707070><size:8>[HTTPS]</size>"
Operador .[#707070,thickness=2].> RutaSIT.Aplicaciónwebprogresiva : "<color:#707070>Usa\n<color:#707070><size:8>[HTTPS]</size>"
RutaSIT.Aplicaciónwebprogresiva .[#707070,thickness=2].> RutaSIT.APIRutaSIT : "<color:#707070>Hace consultas\n<color:#707070><size:8>[HTTPS/JSON (REST)]</size>"
DispositivosGPSdelosbuses .[#707070,thickness=2].> RutaSIT.APIRutaSIT : "<color:#707070>Envía su posición\n<color:#707070><size:8>[HTTPS/JSON]</size>"
RutaSIT.APIRutaSIT .[#707070,thickness=2].> RutaSIT.Basededatos : "<color:#707070>Lee y guarda viajes, posiciones y alertas\n<color:#707070><size:8>[SQL/TCP]</size>"
RutaSIT.APIRutaSIT .[#707070,thickness=2].> RutaSIT.Caché : "<color:#707070>Guarda y lee posiciones y tiempos de llegada\n<color:#707070><size:8>[Redis protocol]</size>"
RutaSIT.Aplicaciónwebprogresiva .[#707070,thickness=2].> Proveedordemapas : "<color:#707070>Carga los mapas\n<color:#707070><size:8>[HTTPS]</size>"
RutaSIT.APIRutaSIT .[#707070,thickness=2].> Proveedordemapas : "<color:#707070>Pide el tiempo de recorrido\n<color:#707070><size:8>[HTTPS/JSON]</size>"
@enduml