@startuml
title <size:24>Deployment View: RutaSIT - Producción</size>\n<size:24>Despliegue en producción (MVP).</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Deployment>

Deployment_Node(Producción.CelularoPCdelusuario, "Celular o PC del usuario", $type="Android / navegador web", $descr="", $tags="", $link="") {
  Container(Producción.CelularoPCdelusuario.Aplicaciónwebprogresiva_1, "Aplicación web progresiva", $techn="JavaScript + Service Worker", $descr="Mapa y consulta de llegadas para el pasajero; panel de alertas para el operador.", $tags="", $link="")
}

Deployment_Node(Producción.VPSenlanube, "VPS en la nube", $type="Ubuntu 24.04, 2 vCPU, 4 GB RAM", $descr="", $tags="", $link="") {
  Deployment_Node(Producción.VPSenlanube.Nginx, "Nginx", $type="Nginx", $descr="Recibe las peticiones y aplica HTTPS.", $tags="", $link="")
  Deployment_Node(Producción.VPSenlanube.Grafana, "Grafana", $type="Grafana", $descr="Muestra el estado del servidor y de la aplicación.", $tags="", $link="")
  Deployment_Node(Producción.VPSenlanube.Servidordeaplicación, "Servidor de aplicación", $type="Django", $descr="", $tags="", $link="") {
    Container(Producción.VPSenlanube.Servidordeaplicación.APIRutaSIT_1, "API RutaSIT", $techn="Python / Django", $descr="Monolito modular que recibe posiciones, calcula tiempos de llegada y genera alertas.", $tags="", $link="")
  }

  Deployment_Node(Producción.VPSenlanube.Servidordebasededatos, "Servidor de base de datos", $type="PostgreSQL + PostGIS", $descr="", $tags="", $link="") {
    ContainerDb(Producción.VPSenlanube.Servidordebasededatos.Basededatos_1, "Base de datos", $techn="PostgreSQL + PostGIS", $descr="Rutas, paraderos, viajes, posiciones y alertas (un esquema por módulo).", $tags="", $link="")
  }

  Deployment_Node(Producción.VPSenlanube.Servidordecaché, "Servidor de caché", $type="Redis", $descr="", $tags="", $link="") {
    ContainerDb(Producción.VPSenlanube.Servidordecaché.Caché_1, "Caché", $techn="Redis", $descr="Última posición de cada bus y tiempos de llegada ya calculados.", $tags="", $link="")
  }

}

Rel(Producción.CelularoPCdelusuario.Aplicaciónwebprogresiva_1, Producción.VPSenlanube.Servidordeaplicación.APIRutaSIT_1, "Hace consultas", $techn="HTTPS/JSON (REST)", $tags="", $link="")
Rel(Producción.VPSenlanube.Servidordeaplicación.APIRutaSIT_1, Producción.VPSenlanube.Servidordebasededatos.Basededatos_1, "Lee y guarda viajes, posiciones y alertas", $techn="SQL/TCP", $tags="", $link="")
Rel(Producción.VPSenlanube.Servidordeaplicación.APIRutaSIT_1, Producción.VPSenlanube.Servidordecaché.Caché_1, "Guarda y lee posiciones y tiempos de llegada", $techn="Redis protocol", $tags="", $link="")
Rel(Producción.CelularoPCdelusuario.Aplicaciónwebprogresiva_1, Producción.VPSenlanube.Nginx, "Envía las consultas", $techn="HTTPS", $tags="", $link="")
Rel(Producción.VPSenlanube.Nginx, Producción.VPSenlanube.Servidordeaplicación.APIRutaSIT_1, "Reenvía las peticiones", $techn="HTTP", $tags="", $link="")
Rel(Producción.VPSenlanube.Servidordeaplicación.APIRutaSIT_1, Producción.VPSenlanube.Grafana, "Envía métricas", $techn="HTTP", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml